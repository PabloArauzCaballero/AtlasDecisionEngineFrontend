# Credenciales de la corrida E2E contra el motor real. Se cargan por entorno y
# NUNCA se versionan: un valor que entra en el historial de git se considera
# comprometido para siempre, aunque se borre el archivo después.
.env.e2e


graphify-out/
node_modules/
.next/
out/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp


# Evidencia responsive generada contra el motor real (yarn evidencia:responsive).
# Son 440 capturas y ~124 MB por corrida: es un ARTEFACTO, se regenera con el
# script y no tiene por qué viajar en la historia. Las capturas curadas a mano de
# docs/visual-evidence/ SÍ se versionan: esas son documentación, no salida.
docs/visual-evidence/real/
.next-audit/

# Pyodide vendorizado por scripts/setup-pyodide.mjs: artefacto reproducible de ~21 MB.
public/pyodide/

# WebR publicado por scripts/setup-webr.mjs desde node_modules: otros ~21 MB reproducibles.
public/webr/

# ATL-013 — Secretos: cualquier fichero .env queda fuera del repositorio, salvo las plantillas.
# Las reglas anteriores enumeraban variantes concretas (.env, .env.local, .env.bak-*), así que un
# nombre no previsto —`.env.bak`, el más probable al hacer una copia rápida— no coincidía con
# ninguna y quedaba listo para commitear. Se invierte: se ignora todo y se readmiten los ejemplos.
.env*
!.env*.example
