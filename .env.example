# Internal server-side destination read by the Next.js proxy at request time.
#
# Este valor es el del portal corriendo EN EL ANFITRIÓN (`yarn dev`, puerto 5173).
# El portal en Docker (5180) NO lo usa: su destino lo fija `docker-compose.yml`
# como `http://api:3000`, contenedor a contenedor. Son dos rutas distintas al
# mismo motor y confundirlas costó una tarde de 502.
#
# `127.0.0.1` y no `localhost`: en Windows `localhost` resuelve primero por IPv6
# y el motor escucha en IPv4.
DECISION_ENGINE_URL=http://127.0.0.1:3000

# Sólo si necesitas que el CONTENEDOR del portal hable con un motor distinto del
# servicio `api` de la red de Compose. Vacío = `http://api:3000`.
# FRONTEND_CONTAINER_ENGINE_URL=

# ¿Hay un proxy de confianza (ingress, balanceador, CDN) DELANTE de este portal?
# Sólo entonces se reenvía `x-forwarded-for` al motor. Puesto a `true` sin ese
# proxy delante, cualquier navegador podría declarar la IP que quisiera y el
# motor la registraría como buena en la auditoría. En duda, déjalo en `false`:
# el motor se queda sin IP de origen, que es preferible a registrar una falsa.
TRUSTED_PROXY=false

# Browser requests remain same-origin so the HttpOnly refresh cookie is preserved.
NEXT_PUBLIC_API_BASE_URL=/
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Ambiente en el que corre este frontend (DEV, STAGING, TEST, PRODUCTION...).
# Se muestra como aviso en la pantalla de acceso cuando NO es PRODUCTION, para
# que nadie confunda un entorno de pruebas con el real. Vacío = no se muestra.
NEXT_PUBLIC_ENVIRONMENT=DEV

# Dónde vive el portal interno de ATLAS. Con esto, la revisión manual enlaza al
# expediente completo del cliente (extractos, documentos añadidos después y la
# bitácora de quién abrió cada archivo), que es lo que el Motor NO tiene: aquí
# sólo llegan las tres imágenes que se evaluaron. Vacío = el enlace no se pinta,
# que es lo correcto si el portal no está desplegado: un enlace roto en la
# pantalla donde se decide un caso hace dudar de si el material existe.
NEXT_PUBLIC_ADMIN_PORTAL_URL=

# Techo de espera del salto portal→motor, en milisegundos. El navegador ya se
# rinde antes (NEXT_PUBLIC_API_TIMEOUT_MS); esto evita que una petición que el
# motor aceptó y no contesta retenga un hueco del servidor indefinidamente.
DECISION_ENGINE_TIMEOUT_MS=20000

# Secreto para raspar /metrics A TRAVÉS del portal. Sin declararlo, la ruta
# responde 404 y las métricas del motor NO salen a Internet — que es lo correcto
# en la mayoría de despliegues: quien vigila el motor lo hace contra el motor,
# dentro de la red. Declarar esto sólo si el raspador no puede llegar de otra
# forma, y entonces con un valor largo y aleatorio.
# METRICS_SCRAPE_TOKEN=

# Clave de SERVICIO del generador documental, que desde 2026-08 no acepta peticiones
# anonimas. Debe coincidir con PDF_SERVICE_API_KEY del motor. Sin ella, imprimir falla
# con 502 PDF_WORKER_UNAUTHORIZED — y NO cierra la sesion de nadie, que es lo que hacia
# antes de que el proxy distinguiera un 401 del worker de un 401 del motor.
PDF_WORKER_SERVICE_KEY=

# Destino del cuaderno de datos: AtlasBackend (su API_PUBLISH_PORT).
ATLAS_BACKEND_URL=http://127.0.0.1:53005
